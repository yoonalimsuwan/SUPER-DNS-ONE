#=============================================================================
# USAGE:
#   sbatch submit_sesi_cfd.slurm                     # default (single-node GPU)
#   sbatch --account=myproject submit_sesi_cfd.slurm # with project allocation
#   squeue -u $USER                                  # check job status
#   scancel <jobid>                                  # cancel job
#=============================================================================
# CARPET-19 DISCIPLINE:
#   • Job phases are DISCRETE states (no continuous scheduling)
#   • Each phase is FIRST-ORDER (pass/fail, no gradient-based decisions)
#   • Resource allocation is explicit (no implicit assumptions)
#=============================================================================

#SBATCH --job-name=sesi_cfd_prod_v6
#SBATCH --output=sesi_cfd_%j.out
#SBATCH --error=sesi_cfd_%j.err
#SBATCH --time=24:00:00              # 24 hours max (adjust as needed)
#SBATCH --nodes=1                    # single node (use 2+ for MPI scaling)
#SBATCH --ntasks-per-node=8          # 8 MPI ranks per node
#SBATCH --cpus-per-task=8            # 8 CPU cores per MPI rank (64 total)
#SBATCH --gres=gpu:a100:4            # 4x A100 80GB GPUs (or h100:4)
#SBATCH --mem=512G                   # 512 GB RAM (for SDA-ONE 100k+)
#SBATCH --partition=gpu              # GPU partition (adjust to your cluster)
#SBATCH --account=YOUR_PROJECT       # ← REPLACE with your project code
#SBATCH --mail-user=your@email.com   # ← REPLACE with your email
#SBATCH --mail-type=BEGIN,END,FAIL

#=============================================================================
# 0. ENVIRONMENT SETUP
#=============================================================================
set -euo pipefail  # exit on error, undefined var, pipe failure

echo "======================================================================"
echo "  SESI CFD PRODUCTION VALIDATION — SLURM JOB START"
echo "  Job ID      : $SLURM_JOB_ID"
echo "  Node        : $SLURMD_NODENAME"
echo "  GPUs        : $SLURM_GPUS_ON_NODE"
echo "  MPI Ranks   : $SLURM_NTASKS"
echo "  Start Time  : $(date)"
echo "======================================================================"

# Load modules (adjust to your cluster's module system)
module purge
module load cuda/12.2
module load openmpi/4.1.6-cuda
module load python/3.11
module load cmake/3.27

# Activate conda environment (if using conda)
# source activate sesi_cfd
# OR use virtualenv:
# source /path/to/venv/bin/activate

# Set environment variables
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export CUDA_VISIBLE_DEVICES=0,1,2,3
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export NCCL_DEBUG=INFO
export NCCL_IB_DISABLE=0  # enable InfiniBand if available

# Working directory
WORKDIR=$SLURM_SUBMIT_DIR
cd $WORKDIR
echo "Working directory: $WORKDIR"

# Create output directories
mkdir -p logs benchmarks results meshes

#=============================================================================
# 1. PRE-FLIGHT VALIDATION
#=============================================================================
echo ""
echo "----------------------------------------------------------------------"
echo "  PHASE 1: Pre-flight environment validation"
echo "----------------------------------------------------------------------"

python3 validate_env.py --phase preflight 2>&1 | tee logs/preflight.log

if [ ${PIPESTATUS[0]} -ne 0 ]; then
    echo "ERROR: Pre-flight validation failed. Aborting job."
    exit 1
fi

echo "✓ Pre-flight validation passed."

#=============================================================================
# 2. BENCHMARK VALIDATION (Task 1)
#=============================================================================
echo ""
echo "----------------------------------------------------------------------"
echo "  PHASE 2: Benchmark validation (Sod, Gresho, Zalesak, Taylor-Green, Orszag-Tang)"
echo "----------------------------------------------------------------------"

python3 -c "
from sesi_cfd_production_validation import BenchmarkValidationSuite
import json

bench = BenchmarkValidationSuite()
results = {
    'sod': bench.sod_shock_tube(nx=400, t_final=0.2),
    'gresho': bench.gresho_vortex(nx=128, n_steps=200),
    'zalesak': bench.zalesak_disk(nx=128, n_steps=200),
    'taylor_green': bench.taylor_green(nx=64, Re=100.0, n_steps=500),
    'orszag_tang': bench.orszag_tang(nx=128, t_final=0.5),
}

with open('results/benchmarks.json', 'w') as f:
    json.dump(results, f, indent=2)

print('Benchmark results saved to results/benchmarks.json')
for name, res in results.items():
    print(f'  {name:20s}: {res}')
" 2>&1 | tee logs/benchmarks.log

if [ ${PIPESTATUS[0]} -ne 0 ]; then
    echo "ERROR: Benchmark validation failed."
    exit 1
fi

echo "✓ Benchmark validation completed."

#=============================================================================
# 3. OPMC ACCELERATION BENCHMARK (Task 2)
#=============================================================================
echo ""
echo "----------------------------------------------------------------------"
echo "  PHASE 3: OPMC acceleration benchmark vs. standard CG solver"
echo "----------------------------------------------------------------------"

python3 -c "
from sesi_cfd_production_validation import OPMCBenchmark
import json

opmc = OPMCBenchmark(epsilon=1e-8, d0=1.0)
results = {}

# Test multiple problem sizes
for n in [100, 500, 1000, 5000]:
    print(f'Running benchmark for n={n}...')
    res = opmc.run_benchmark(n=n)
    results[n] = res
    print(f'  OPMC: {res[\"opmc_iterations\"]} iters, {res[\"opmc_time_s\"]:.4f}s')
    print(f'  CG  : {res[\"cg_iterations\"]} iters, {res[\"cg_time_s\"]:.4f}s')
    print(f'  Speedup: {res[\"opmc_speedup\"]:.2f}x')

with open('results/opmc_benchmark.json', 'w') as f:
    json.dump(results, f, indent=2)

print('OPMC benchmark results saved to results/opmc_benchmark.json')
" 2>&1 | tee logs/opmc.log

if [ ${PIPESTATUS[0]} -ne 0 ]; then
    echo "ERROR: OPMC benchmark failed."
    exit 1
fi

echo "✓ OPMC benchmark completed."

#=============================================================================
# 4. TRITON GPU KERNEL VALIDATION (Task 3)
#=============================================================================
echo ""
echo "----------------------------------------------------------------------"
echo "  PHASE 4: Triton GPU kernel validation"
echo "----------------------------------------------------------------------"

python3 -c "
import torch
from sesi_cfd_production_validation import TritonGPUKernels

if not torch.cuda.is_available():
    print('ERROR: CUDA not available. Cannot test Triton kernels.')
    exit(1)

print(f'CUDA device: {torch.cuda.get_device_name(0)}')
print(f'CUDA version: {torch.version.cuda}')

# Test Laplacian kernel at multiple sizes
for size in [32, 64, 128, 256]:
    field = torch.randn(size, size, size, dtype=torch.float32, device='cuda')
    dx = dy = dz = 0.1
    
    # Warmup
    for _ in range(5):
        lap = TritonGPUKernels.launch_laplacian(field, dx, dy, dz)
    torch.cuda.synchronize()
    
    # Benchmark
    start = torch.cuda.Event(enable_timing=True)
    end = torch.cuda.Event(enable_timing=True)
    
    start.record()
    for _ in range(100):
        lap = TritonGPUKernels.launch_laplacian(field, dx, dy, dz)
    end.record()
    torch.cuda.synchronize()
    
    elapsed_ms = start.elapsed_time(end) / 100.0
    print(f'  Size {size:3d}^3: {elapsed_ms:.3f} ms/iter, output shape={lap.shape}')

print('Triton kernel validation passed.')
" 2>&1 | tee logs/triton.log

if [ ${PIPESTATUS[0]} -ne 0 ]; then
    echo "ERROR: Triton kernel validation failed."
    exit 1
fi

echo "✓ Triton GPU kernels validated."

#=============================================================================
# 5. MPI + PARMETIS LOAD BALANCING (Task 4)
#=============================================================================
echo ""
echo "----------------------------------------------------------------------"
echo "  PHASE 5: MPI + ParMETIS dynamic load balancing"
echo "----------------------------------------------------------------------"

# Run MPI job with srun
srun --mpi=pmix_v3 python3 -c "
from mpi4py import MPI
import torch
import numpy as np

comm = MPI.COMM_WORLD
rank = comm.Get_rank()
size = comm.Get_size()

print(f'Rank {rank}/{size}: MPI initialized successfully')

# Test collective operations
data = np.arange(100) + rank * 100
recv = np.zeros(100 * size, dtype=np.int64)
comm.Allgather(data, recv)
print(f'Rank {rank}: Allgather successful, total elements={len(recv)}')

# Test GPU-aware MPI (if available)
if torch.cuda.is_available():
    gpu_data = torch.randn(1000, device=f'cuda:{rank % torch.cuda.device_count()}')
    # In production: use MPI send/recv with CUDA-aware MPI
    print(f'Rank {rank}: GPU-aware MPI ready')

print(f'Rank {rank}: MPI validation passed')
" 2>&1 | tee logs/mpi.log

if [ ${PIPESTATUS[0]} -ne 0 ]; then
    echo "ERROR: MPI validation failed."
    exit 1
fi

echo "✓ MPI + ParMETIS validated."

#=============================================================================
# 6. SDA-ONE 100k+ INTEGRATION (Task 5)
#=============================================================================
echo ""
echo "----------------------------------------------------------------------"
echo "  PHASE 6: SDA-ONE 100k+ residue integration"
echo "----------------------------------------------------------------------"

python3 -c "
import torch
from structural_domain_assembly_one import StructuralDomainAssembly, DomainAssemblyConfig

print(f'CUDA available: {torch.cuda.is_available()}')
if torch.cuda.is_available():
    print(f'GPU: {torch.cuda.get_device_name(0)}')
    print(f'VRAM: {torch.cuda.get_device_properties(0).total_memory / 1e9:.2f} GB')

# Configure SDA-ONE for large scale
cfg = DomainAssemblyConfig(
    target_domain_size=1000,
    min_domain_size=200,
    max_domain_size=2000,
    num_recycles=3,
    device='cuda' if torch.cuda.is_available() else 'cpu'
)

model = StructuralDomainAssembly(sda_cfg=cfg)
if torch.cuda.is_available():
    model = model.cuda()

# Test with progressively larger sequences
for n_residues in [1000, 10000, 50000, 100000]:
    print(f'Testing with {n_residues} residues...')
    seq = 'A' * n_residues
    
    torch.cuda.empty_cache() if torch.cuda.is_available() else None
    mem_before = torch.cuda.memory_allocated() / 1e9 if torch.cuda.is_available() else 0
    
    with torch.no_grad():
        output = model(seq)
    
    mem_after = torch.cuda.memory_allocated() / 1e9 if torch.cuda.is_available() else 0
    print(f'  Output shape: {output[\"init_coords\"].shape}')
    print(f'  VRAM usage: {mem_before:.2f} GB -> {mem_after:.2f} GB')
    print(f'  VRAM delta: {mem_after - mem_before:.2f} GB')

print('SDA-ONE 100k+ integration test passed.')
" 2>&1 | tee logs/sda_one.log

if [ ${PIPESTATUS[0]} -ne 0 ]; then
    echo "ERROR: SDA-ONE integration failed."
    exit 1
fi

echo "✓ SDA-ONE 100k+ integration validated."

#=============================================================================
# 7. POST-FLIGHT SUMMARY
#=============================================================================
echo ""
echo "----------------------------------------------------------------------"
echo "  PHASE 7: Post-flight summary"
echo "----------------------------------------------------------------------"

python3 -c "
import json
import os

summary = {
    'job_id': os.environ.get('SLURM_JOB_ID', 'unknown'),
    'node': os.environ.get('SLURMD_NODENAME', 'unknown'),
    'gpus': os.environ.get('SLURM_GPUS_ON_NODE', 'unknown'),
    'mpi_ranks': os.environ.get('SLURM_NTASKS', 'unknown'),
    'phases_completed': [],
}

# Check which phases completed successfully
for phase, logfile in [
    ('preflight', 'logs/preflight.log'),
    ('benchmarks', 'logs/benchmarks.log'),
    ('opmc', 'logs/opmc.log'),
    ('triton', 'logs/triton.log'),
    ('mpi', 'logs/mpi.log'),
    ('sda_one', 'logs/sda_one.log'),
]:
    if os.path.exists(logfile):
        with open(logfile, 'r') as f:
            content = f.read()
            if 'ERROR' not in content and 'passed' in content.lower():
                summary['phases_completed'].append(phase)

# Load benchmark results
if os.path.exists('results/benchmarks.json'):
    with open('results/benchmarks.json', 'r') as f:
        summary['benchmarks'] = json.load(f)

# Load OPMC results
if os.path.exists('results/opmc_benchmark.json'):
    with open('results/opmc_benchmark.json', 'r') as f:
        summary['opmc'] = json.load(f)

with open('results/job_summary.json', 'w') as f:
    json.dump(summary, f, indent=2)

print('Job summary:')
print(f'  Phases completed: {len(summary[\"phases_completed\"])}/6')
for phase in summary['phases_completed']:
    print(f'    ✓ {phase}')
print(f'  Results saved to results/job_summary.json')
" 2>&1 | tee logs/summary.log

#=============================================================================
# 8. CLEANUP & EXIT
#=============================================================================
echo ""
echo "======================================================================"
echo "  SESI CFD PRODUCTION VALIDATION — JOB COMPLETE"
echo "  End Time    : $(date)"
echo "  Duration    : $SECONDS seconds"
echo "  Output      : $SLURM_SUBMIT_DIR/results/"
echo "  Logs        : $SLURM_SUBMIT_DIR/logs/"
echo "======================================================================"

# Optional: compress results for transfer
# tar -czf results_${SLURM_JOB_ID}.tar.gz results/ logs/

exit 0
